# Local development defaults only. Replace every value outside local development.
POSTGRES_DB=github_analytics
POSTGRES_USER=github_analytics
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_PORT=55432
KAFKA_PORT=9092
GITHUB_WEBHOOK_SECRET=local_only_change_me
GITHUB_WEBHOOK_MAX_BODY_BYTES=1048576
GITHUB_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
GITHUB_KAFKA_RAW_TOPIC=github.events.raw.v1
GITHUB_KAFKA_PUBLISH_TIMEOUT_SECONDS=5
GITHUB_KAFKA_READINESS_TIMEOUT_SECONDS=1
WAREHOUSE_DATABASE_URL=postgresql://github_analytics:local_only_change_me@localhost:55432/github_analytics
WAREHOUSE_DATABASE_POOL_TIMEOUT_SECONDS=5
WAREHOUSE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
WAREHOUSE_KAFKA_RAW_TOPIC=github.events.raw.v1
WAREHOUSE_KAFKA_DLQ_TOPIC=github.events.dlq.v1
WAREHOUSE_KAFKA_GROUP_ID=warehouse-writer
WAREHOUSE_KAFKA_POLL_TIMEOUT_SECONDS=1
WAREHOUSE_KAFKA_DLQ_PUBLISH_TIMEOUT_SECONDS=5
PR_MONITOR_DATABASE_URL=postgresql://github_analytics:local_only_change_me@localhost:55432/github_analytics
PR_MONITOR_DATABASE_POOL_TIMEOUT_SECONDS=5
PR_MONITOR_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PR_MONITOR_KAFKA_RAW_TOPIC=github.events.raw.v1
PR_MONITOR_KAFKA_DLQ_TOPIC=github.events.dlq.v1
PR_MONITOR_KAFKA_GROUP_ID=pr-monitor
PR_MONITOR_KAFKA_POLL_TIMEOUT_SECONDS=1
PR_MONITOR_KAFKA_DLQ_PUBLISH_TIMEOUT_SECONDS=5
PR_MONITOR_STALE_AFTER_HOURS=24
PR_MONITOR_STALE_SWEEP_INTERVAL_SECONDS=60
