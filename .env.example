# Local development defaults only. Replace every value outside local development.
POSTGRES_DB=github_analytics
POSTGRES_USER=github_analytics
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_PORT=55432
KAFKA_PORT=9092
GITHUB_WEBHOOK_SECRET=local_only_change_me
GITHUB_WEBHOOK_MAX_BODY_BYTES=1048576
GITHUB_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
GITHUB_KAFKA_RAW_TOPIC=github.events.raw.v1
GITHUB_KAFKA_PUBLISH_TIMEOUT_SECONDS=5
GITHUB_KAFKA_READINESS_TIMEOUT_SECONDS=1
WAREHOUSE_DATABASE_URL=postgresql://github_analytics:local_only_change_me@localhost:55432/github_analytics
WAREHOUSE_DATABASE_POOL_TIMEOUT_SECONDS=5
WAREHOUSE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
WAREHOUSE_KAFKA_RAW_TOPIC=github.events.raw.v1
WAREHOUSE_KAFKA_DLQ_TOPIC=github.events.dlq.v1
WAREHOUSE_KAFKA_GROUP_ID=warehouse-writer
WAREHOUSE_KAFKA_POLL_TIMEOUT_SECONDS=1
WAREHOUSE_KAFKA_DLQ_PUBLISH_TIMEOUT_SECONDS=5
PR_MONITOR_DATABASE_URL=postgresql://github_analytics:local_only_change_me@localhost:55432/github_analytics
PR_MONITOR_DATABASE_POOL_TIMEOUT_SECONDS=5
PR_MONITOR_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PR_MONITOR_KAFKA_RAW_TOPIC=github.events.raw.v1
PR_MONITOR_KAFKA_DLQ_TOPIC=github.events.dlq.v1
PR_MONITOR_KAFKA_GROUP_ID=pr-monitor
PR_MONITOR_KAFKA_POLL_TIMEOUT_SECONDS=1
PR_MONITOR_KAFKA_DLQ_PUBLISH_TIMEOUT_SECONDS=5
PR_MONITOR_STALE_AFTER_HOURS=24
PR_MONITOR_STALE_SWEEP_INTERVAL_SECONDS=60
BACKFILL_DATABASE_URL=postgresql://github_analytics:local_only_change_me@localhost:55432/github_analytics
BACKFILL_DATABASE_POOL_TIMEOUT_SECONDS=5
BACKFILL_GITHUB_TOKEN=replace_with_a_short_lived_installation_token
BACKFILL_GITHUB_REPOSITORY=example-org/delivery-demo
BACKFILL_GITHUB_REPOSITORY_ID=20001
BACKFILL_GITHUB_INSTALLATION_ID=10001
BACKFILL_GITHUB_GRAPHQL_URL=https://api.github.com/graphql
BACKFILL_GITHUB_REST_URL=https://api.github.com
BACKFILL_GITHUB_API_VERSION=2026-03-10
BACKFILL_GITHUB_PAGE_SIZE=50
BACKFILL_GITHUB_REQUEST_TIMEOUT_SECONDS=20
BACKFILL_GITHUB_MAX_RATE_LIMIT_RETRIES=3
BACKFILL_GITHUB_SECONDARY_BACKOFF_SECONDS=60
DBT_POSTGRES_HOST=localhost
DBT_POSTGRES_PORT=55432
DBT_POSTGRES_DB=github_analytics
DBT_POSTGRES_USER=github_analytics
DBT_POSTGRES_PASSWORD=local_only_change_me
DBT_POSTGRES_SCHEMA=analytics
ANALYTICS_REFRESH_DATABASE_URL=postgresql://github_analytics:local_only_change_me@localhost:55432/github_analytics
ANALYTICS_REFRESH_DATABASE_POOL_TIMEOUT_SECONDS=5
ANALYTICS_REFRESH_SOURCE_SCHEMA=raw
ANALYTICS_REFRESH_SOURCE_IDENTIFIER=github_events
ANALYTICS_REFRESH_DBT_EXECUTABLE=dbt
ANALYTICS_REFRESH_DBT_PROJECT_DIR=dbt/github_analytics
ANALYTICS_REFRESH_DBT_PROFILES_DIR=dbt/github_analytics
ANALYTICS_REFRESH_DBT_TARGET_DIR=dbt/github_analytics/target/analytics_refresh
ANALYTICS_REFRESH_DBT_COMMAND_TIMEOUT_SECONDS=900
